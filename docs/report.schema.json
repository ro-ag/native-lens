{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ro-ag/native-lens/blob/main/docs/report.schema.json",
  "title": "native-lens comparison report",
  "type": "object",
  "required": [
    "schema_version",
    "overall_score",
    "config",
    "reference",
    "candidate",
    "alignment",
    "structural",
    "components",
    "raster_secondary",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "config": { "type": "object" },
    "reference": { "$ref": "#/$defs/page" },
    "candidate": { "$ref": "#/$defs/page" },
    "alignment": {
      "type": "object",
      "required": [
        "candidate_scale",
        "reference_to_canvas_px",
        "candidate_to_canvas_px",
        "canvas_width_px",
        "canvas_height_px"
      ],
      "properties": {
        "candidate_scale": { "type": "number", "exclusiveMinimum": 0 },
        "reference_to_canvas_px": { "$ref": "#/$defs/affine" },
        "candidate_to_canvas_px": { "$ref": "#/$defs/affine" },
        "canvas_width_px": { "type": "integer", "minimum": 1 },
        "canvas_height_px": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "structural": { "type": "object" },
    "components": { "type": "object" },
    "raster_secondary": { "type": "object" },
    "artifacts": {
      "type": "object",
      "required": ["aligned_reference", "aligned_candidate", "overlay", "diff"],
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "affine": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false
    },
    "page": {
      "type": "object",
      "required": [
        "source",
        "staff_space_px",
        "estimated_skew_degrees",
        "binarization_threshold",
        "staves",
        "systems",
        "objects"
      ],
      "properties": {
        "source": { "type": "object" },
        "staff_space_px": { "type": "number", "exclusiveMinimum": 0 },
        "estimated_skew_degrees": { "type": "number" },
        "binarization_threshold": { "type": "integer", "minimum": 0, "maximum": 255 },
        "staves": { "type": "array", "minItems": 1 },
        "systems": { "type": "array", "minItems": 1 },
        "objects": { "type": "array" }
      },
      "additionalProperties": false
    }
  }
}
